---
import Base from '../../layouts/Base.astro';
import Calendar from '../../components/Calendar.astro';
import { getGames, getPlatforms } from '../../lib/wp';

export async function getStaticPaths() {
  const [games, platforms] = await Promise.all([getGames(), getPlatforms()]);
  return platforms.map((platform) => ({
    params: { slug: platform.slug },
    props: { platform, games: games.filter((g) => g.platforms.some((p) => p.slug === platform.slug)) },
  }));
}

const { platform, games } = Astro.props;
---
<Base title={`${platform.name} releases`} description={`Every ${platform.name} game releasing in the next 90 days, week by week.`}>
  <h1>{platform.name}</h1>
  <p class="lede">{games.length} {games.length === 1 ? 'game' : 'games'} coming to {platform.name} in the next 90 days.</p>
  <Calendar games={games} />
</Base>

<style>
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing: -0.03em; margin: 1rem 0 0.25rem; }
  .lede { color: var(--muted); margin: 0 0 2rem; }
</style>
