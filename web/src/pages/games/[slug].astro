---
import Base from '../../layouts/Base.astro';
import { getGames } from '../../lib/wp';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const facts = [
  ['Release', game.tba ? 'To be announced' : formatDate(game.releaseDate, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })],
  ['Platforms', game.platforms.map((p) => p.name).join(', ')],
  ['Genres', game.genres.map((g) => g.name).join(', ')],
  ['Developer', game.developer],
  ['Publisher', game.publisher],
].filter(([, v]) => v);
---
<Base title={game.title} description={game.excerpt || `${game.title} releases ${formatDate(game.releaseDate)}.`} image={game.cover}>
  <article class="game">
    <div class="cover">
      {game.cover && <img src={game.cover} alt={`${game.title} cover art`} width="528" height="748" />}
    </div>

    <div class="body">
      <p class="back"><a href="/">← All releases</a></p>
      <h1>{game.title}</h1>

      <dl class="facts">
        {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>

      <div class="content" set:html={game.content} />

      <p class="links">
        {game.website && <a href={game.website} rel="noopener">Official site</a>}
        {game.sourceUrl && <a href={game.sourceUrl} rel="noopener">More on IGDB</a>}
      </p>
    </div>
  </article>
</Base>

<style>
  .game {
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) 1fr;
    gap: 3rem;
    padding: 1rem 0 2rem;
  }
  .cover { position: sticky; top: 1.5rem; align-self: start; border-radius: 8px; overflow: hidden; background: var(--line); }
  .back { margin: 0 0 1rem; }
  .back a { color: var(--muted); text-decoration: none; }
  .back a:hover { color: var(--ink); text-decoration: underline; }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.05; letter-spacing: -0.025em; margin: 0 0 1.5rem; font-weight: 600; }

  .facts {
    display: grid; grid-template-columns: 7rem 1fr; gap: 0.5rem 1rem;
    margin: 0 0 2rem; padding: 1rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }

  .content { max-width: 65ch; }
  .content :global(p) { margin: 0 0 1rem; }

  /* Blocks rendered by the games-core WordPress plugin */
  .content :global(.games-countdown) {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem;
    margin: 0 0 1.5rem; padding: 0.6rem 0.9rem;
    border-radius: 6px; background: var(--raised); border: 1px solid var(--line);
  }
  .content :global(.games-countdown strong) { font-family: var(--display); font-weight: 600; color: var(--accent); }
  .content :global(.games-countdown time) { color: var(--muted); font-size: 0.9rem; }
  .content :global(.games-trailer) { margin: 0 0 1.5rem; }
  .content :global(.games-trailer iframe) { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: 6px; }

  .links { display: flex; gap: 1.5rem; margin-top: 2rem; }
  .links a { color: var(--accent); }

  @media (max-width: 44rem) {
    .game { grid-template-columns: 1fr; gap: 1.5rem; }
    .cover { position: static; max-width: 14rem; }
    .facts { grid-template-columns: 6rem 1fr; }
  }
</style>
