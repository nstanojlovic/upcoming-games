---
import Base from '../layouts/Base.astro';
import FeaturedSlider from '../components/FeaturedSlider.astro';
import Browse from '../components/Browse.astro';
import { getFeatured, getGames } from '../lib/wp';

const [games, featured] = await Promise.all([getGames(), getFeatured()]);
---
<Base title="Upcoming" image={featured[0]?.hero || featured[0]?.cover}>
  <h1 class="sr-only">Upcoming video game releases, week by week</h1>
  <FeaturedSlider games={featured} />
  <Browse games={games} />
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
