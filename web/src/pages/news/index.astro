---
import Base from '../../layouts/Base.astro';
import { getNews } from '../../lib/wp';
import { formatDate } from '../../lib/dates';

const posts = await getNews();
const [lead, ...rest] = posts;
---
<Base title="News" description="Game release news: delays, dates and announcements.">
  <h1>News</h1>

  {posts.length === 0 && <p class="empty">No news yet. Check back soon.</p>}

  {lead && (
    <article class="lead">
      <a href={`/news/${lead.slug}/`} class="lead-link">
        {lead.image && <img src={lead.image} alt={lead.imageAlt} loading="eager" />}
        <div>
          <p class="meta"><time datetime={lead.date}>{formatDate(lead.date)}</time>{lead.categories[0] && <> · {lead.categories[0].name}</>}</p>
          <h2>{lead.title}</h2>
          {lead.excerpt && <p class="excerpt">{lead.excerpt}</p>}
        </div>
      </a>
    </article>
  )}

  {rest.length > 0 && (
    <ul class="list">
      {rest.map((p) => (
        <li>
          <a href={`/news/${p.slug}/`}>
            {p.image ? <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" /> : <span class="ph" aria-hidden="true" />}
            <p class="meta"><time datetime={p.date}>{formatDate(p.date)}</time>{p.categories[0] && <> · {p.categories[0].name}</>}</p>
            <h2>{p.title}</h2>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing: -0.03em; margin: 1rem 0 1.5rem; }
  .empty { color: var(--muted); }
  a { text-decoration: none; }
  a:hover h2 { text-decoration: underline; }
  img, .ph { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; background: var(--line); display: block; }
  .meta { margin: 0.75rem 0 0.25rem; font-size: 0.85rem; color: var(--muted); }

  .lead-link { display: grid; grid-template-columns: 3fr 2fr; gap: 2rem; align-items: center; padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .lead h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0; font-weight: 600; }
  .excerpt { color: var(--muted); margin: 0.75rem 0 0; }

  .list { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 2rem 1.5rem; }
  .list h2 { font-size: 1.1rem; line-height: 1.3; margin: 0; font-weight: 600; }

  @media (max-width: 44rem) {
    .lead-link { grid-template-columns: 1fr; gap: 0; }
  }
</style>
