---
/**
 * Gamepad icon + platform names, releases.com style: "PS5 / Xbox Series / PC".
 * `links` turns each name into a link to its platform page.
 */
import type { Term } from '../lib/wp';
import { shortName } from '../lib/platforms';
import PlatformIcon from './PlatformIcon.astro';

interface Props { platforms: Term[]; links?: boolean; full?: boolean; class?: string }
const { platforms, links = false, full = false, class: cls } = Astro.props;
const label = (p: Term) => (full ? p.name : shortName(p.name));
---
{platforms.length > 0 && (
  <span class:list={['plats', cls]} title={platforms.map((p) => p.name).join(', ')}>
    <PlatformIcon />
    <span class="names">
      {platforms.map((p, i) => (<>
        {i > 0 && <span class="sep" aria-hidden="true"> / </span>}
        {links ? <a href={`/platform/${p.slug}/`}>{label(p)}</a> : <span>{label(p)}</span>}
      </>))}
    </span>
  </span>
)}

<style>
  .plats { display: inline-flex; align-items: flex-start; gap: 0.35rem; min-width: 0; max-width: 100%; }
  .plats :global(.gamepad) { margin-top: 0.2em; opacity: 0.85; }
  .names { min-width: 0; }
  .sep { opacity: 0.6; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent-text); text-decoration: underline; }
</style>
