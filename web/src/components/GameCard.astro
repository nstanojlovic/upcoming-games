---
import type { Game } from '../lib/wp';
import { formatDate } from '../lib/dates';
import PlatformList from './PlatformList.astro';

interface Props { game: Game }
const { game } = Astro.props;
---
<article class="card" data-genres={game.genres.map((g) => g.slug).join(' ')} data-platforms={game.platforms.map((p) => p.slug).join(' ')}>
  <a href={`/games/${game.slug}/`} class="card-link">
    <div class="cover">
      {game.coverSmall
        ? <img src={game.coverSmall} alt="" width="264" height="374" loading="lazy" decoding="async" />
        : <div class="no-cover" aria-hidden="true">{game.title.slice(0, 1)}</div>}
    </div>
    <h3>{game.title}</h3>
  </a>
  <p class="date">
    <time datetime={game.releaseDate}>{formatDate(game.releaseDate, { weekday: 'short', day: 'numeric', month: 'short' })}</time>
  </p>
  {game.platforms.length > 0 && <p class="platforms"><PlatformList platforms={game.platforms} /></p>}
</article>

<style>
  .card { min-width: 0; }
  .card[hidden] { display: none; }
  .card-link { display: block; text-decoration: none; }
  .cover {
    aspect-ratio: 264 / 374;
    border-radius: 6px;
    overflow: hidden;
    background: var(--line);
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .card-link:hover .cover { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .no-cover {
    height: 100%; display: grid; place-items: center;
    font-family: var(--display); font-size: 2.5rem; color: var(--muted);
  }
  h3 { font-size: 1rem; font-weight: 600; line-height: 1.3; margin: 0.6rem 0 0.15rem; }
  .card-link:hover h3 { text-decoration: underline; }
  .date { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .platforms { margin: 0.3rem 0 0; font-size: 0.78rem; line-height: 1.35; color: var(--muted); }
</style>
