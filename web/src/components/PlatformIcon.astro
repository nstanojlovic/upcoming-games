---
import { family, shortName, type Family } from '../lib/platforms';

interface Props { name: string; label?: boolean }
const { name, label = true } = Astro.props;
const f: Family = family(name);
---
<span class="platform" title={name}>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {f === 'console' && (<>
      <path d="M7 8h10a4 4 0 0 1 3.9 4.9l-.9 3.9a2.2 2.2 0 0 1-3.8 1L14.5 16h-5l-1.7 1.8a2.2 2.2 0 0 1-3.8-1l-.9-3.9A4 4 0 0 1 7 8Z" />
      <path d="M8 11v3M6.5 12.5h3" /><circle cx="15.5" cy="12" r=".6" fill="currentColor" /><circle cx="17" cy="13.5" r=".6" fill="currentColor" />
    </>)}
    {f === 'handheld' && (<>
      <rect x="2" y="6" width="20" height="12" rx="3" />
      <rect x="7" y="8.5" width="10" height="7" rx="1" />
      <path d="M4.5 11v2M3.5 12h2" /><circle cx="19.5" cy="11" r=".6" fill="currentColor" /><circle cx="19.5" cy="13.5" r=".6" fill="currentColor" />
    </>)}
    {f === 'desktop' && (<>
      <rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" />
    </>)}
    {f === 'mobile' && (<>
      <rect x="7" y="2.5" width="10" height="19" rx="2" /><path d="M11 18.5h2" />
    </>)}
    {f === 'vr' && (<>
      <path d="M4 8h16a1.5 1.5 0 0 1 1.5 1.5v5A1.5 1.5 0 0 1 20 16h-4l-2-2.5h-4L8 16H4a1.5 1.5 0 0 1-1.5-1.5v-5A1.5 1.5 0 0 1 4 8Z" />
    </>)}
    {f === 'web' && (<>
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
    </>)}
    {f === 'other' && (<>
      <rect x="4" y="4" width="16" height="16" rx="3" /><path d="M9 12h6" />
    </>)}
  </svg>
  {label ? <span>{shortName(name)}</span> : <span class="sr-only">{name}</span>}
</span>

<style>
  .platform { display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap; }
  svg { flex: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
